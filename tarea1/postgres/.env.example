# Plantilla de variables para el contenedor de PostgreSQL 18.
#
#   cp .env.example .env      (en PowerShell: Copy-Item .env.example .env)
#
# Después cambia la contraseña en el .env. El .env NO se sube al repositorio
# (está en el .gitignore); este .env.example sí, porque no trae secretos.
# Si no existe .env, el compose.yaml usa sus valores por defecto.

POSTGRES_DB=proyecto
POSTGRES_USER=proyecto
POSTGRES_PASSWORD=cambia_esta_contrasena

# Puertos del lado de tu máquina (el de la izquierda en «ports:»).
POSTGRES_PORT=5434
ADMINER_PORT=8080
